{
  "name": "token-tracker",
  "version": "0.8.1",
  "description": "Real-time token and cost analytics dashboard for AI coding assistants (Claude Code, OpenAI Codex, Google Antigravity)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint lib/ server.js",
    "badges": "vitest run --reporter=json --outputFile=.vitest-report.json && node scripts/update-badges.js --report .vitest-report.json && rm -f .vitest-report.json",
    "postinstall": "node scripts/setup.js"
  },
  "author": "Martin Pfeffer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepperonas/token-tracker.git"
  },
  "keywords": [
    "token",
    "tracker",
    "dashboard",
    "usage",
    "cost",
    "claude",
    "codex",
    "antigravity",
    "anthropic",
    "openai",
    "gemini"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
